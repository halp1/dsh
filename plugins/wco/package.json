{
  "name": "dsh-plugin-wco",
  "version": "0.1.0",
  "description": "Window Controls Overlay for DeepSeek Harness installed as a PWA: drops the browser title bar and lays the DSH frame out around the native window controls",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pwa",
    "window-controls-overlay",
    "titlebar"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "profiles": [
        "web"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
