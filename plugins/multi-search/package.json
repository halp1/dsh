{
  "name": "dsh-plugin-multi-search",
  "version": "0.1.1",
  "description": "Modular multi-search provider with configurable fallback ordering and settings panel for DeepSeek Harness",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-search",
    "searxng",
    "exa",
    "web-search"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "profiles": [
        "web",
        "headless"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-web": "catalog:dsh",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
