  // Host half: node types, emitting declarations into lib/types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "outDir": "lib/types",
    "rootDir": "src"
  },
  "include": ["src/index.ts"],
  "references": [{ "path": "./tsconfig.client.json" }]
}
