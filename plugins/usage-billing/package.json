    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.32.0",
