    "react-dom": "^18.2.0",
    "semver": "^7.7.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "use-sync-external-store": "1.2.0",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "homepage": "https://github.com/kenz1117/dsh-ui-usage-billing#readme",
  "fork": {
    "upstreamPackage": "@kenz1117/dsh-ui-usage-billing",
    "upstreamRepository": "https://github.com/kenz1117/dsh-ui-usage-billing",
    "upstreamReadme": "https://github.com/kenz1117/dsh-ui-usage-billing#readme",
    "forkedAtTag": "v1.2.6",
    "forkedAtCommit": "4acffb5fb952fcf4b2eb5fb4b37ffc70a2545215",
    "divergence": [
      "src/client/usage-billing-settings.ts: add persisted display-currency pref (localStorage + CustomEvent), default 'usd'",
      "src/client/UsageBilling.tsx: currency state loads/saves the pref; thread currency into UsageBillingTrigger so the chip is not hardcoded CNY",
      "src/client/live-cost.tsx: LiveCostBar + LiveCostChip follow the shared currency pref instead of hardcoded 'cny'",
      "src/client/UsageBilling.module.css: amount never shrinks/clips; label yields first; container breakpoints 200/170 -> 230/190 for wider en labels",
      "src/client/pricing.ts: offline Claude 5.5, GPT-6 Sol/Luna, free Flash, Gemini 3.8 Flash Tiered, and Opus 5 Thinking Fast pricing with normalized model IDs",
      "src/pricing-fetch.ts: accept OpenRouter decimal-string prices and explicit cache-read rates without double-applying promos",
      "src/aggregate.ts: invalidate pre-fix ledger folds so readable historical sessions are repriced"
    ]
  },
  "private": true
}
