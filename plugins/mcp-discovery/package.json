{
  "name": "dsh-plugin-mcp-discovery",
  "version": "0.2.0",
  "description": "Session-local, on-demand native MCP tool discovery for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "license": "MIT",
  "engines": { "node": ">=22.19" },
  "scripts": { "build": "tsdown", "watch": "tsdown --watch", "test": "node --test test/*.test.js" },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-slots"] },
    "compatibility": { "dsh": "0.2.0-rc.2", "profiles": ["web", "headless"] }
  }
}
